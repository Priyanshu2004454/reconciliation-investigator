# ── App ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_long_random_string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://recon_user:recon_pass@localhost:5432/reconciliation_investigator
DATABASE_URL_SYNC=postgresql+psycopg://recon_user:recon_pass@localhost:5432/reconciliation_investigator

# ── Razorpay (Test Mode) ─────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
# NEVER commit real values. NEVER expose RAZORPAY_KEY_SECRET to frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── AI (Claude via Anthropic API) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30

# ── Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Reconciliation Engine ───────────────────────────
MATCH_DATE_WINDOW_DAYS=3
MATCH_AMOUNT_TOLERANCE_PAISE=100

# ── Rate limiting ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
