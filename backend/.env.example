# ── App ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://recon_user:recon_pass@localhost:5432/reconciliation_investigator
DATABASE_URL_SYNC=postgresql+psycopg://recon_user:recon_pass@localhost:5432/reconciliation_investigator

# ── Razorpay (Test Mode) ─────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
# NEVER commit real values. NEVER expose RAZORPAY_KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── AI Provider ──────────────────────────────────────
# Choose your LLM provider: "gemini" (default, Free Tier available) or "anthropic"
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
# Free Tier supports gemini-3.6-flash with generous quota.
GEMINI_API_KEY=

# Model to use. If left blank, defaults to gemini-3.6-flash (for gemini) or
# claude-sonnet-4-6 (for anthropic).
AI_MODEL=gemini-3.6-flash

# Anthropic Claude — https://console.anthropic.com/ (paid credits required)
# Only required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Investigator limits
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=180

# ── Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Reconciliation Engine ───────────────────────────
MATCH_DATE_WINDOW_DAYS=3
MATCH_AMOUNT_TOLERANCE_PAISE=100

# ── Rate limiting ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
